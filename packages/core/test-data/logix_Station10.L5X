<Description>
<![CDATA[Clamping and conveying station 10]]>
</Description>
<DataTypes/>
<Modules>
<Module Name="Local" CatalogNumber="1769-L33ER" Vendor="1" ProductType="14" ProductCode="155" Major="33" Minor="11" ParentModule="Local" ParentModPortId="1" Inhibited="false" MajorFault="true"/>
<Module Name="DI_1" CatalogNumber="1769-IQ16/A" Vendor="1" ProductType="7" ProductCode="10" Major="1" Minor="1" ParentModule="Local" ParentModPortId="3" Inhibited="false" MajorFault="false"/>
<Module Name="DO_2" CatalogNumber="1769-OB16/B" Vendor="1" ProductType="7" ProductCode="11" Major="1" Minor="1" ParentModule="Local" ParentModPortId="3" Inhibited="false" MajorFault="false"/>
<Module Name="AI_3" CatalogNumber="1769-IF4/B" Vendor="1" ProductType="10" ProductCode="6" Major="1" Minor="1" ParentModule="Local" ParentModPortId="3" Inhibited="false" MajorFault="false"/>
</Modules>
<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="Motor_AOI" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2025-02-03T08:15:00.000Z" CreatedBy="eng" EditedDate="2025-02-03T08:15:00.000Z" EditedBy="eng" SoftwareRevision="v33.01">
<Description>
<![CDATA[Contactor motor with run feedback and overload]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Start" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"/>
<Parameter Name="RunFbk" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"/>
<Parameter Name="Overload" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"/>
<Parameter Name="Out" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"/>
<Parameter Name="Fault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"/>
</Parameters>
<LocalTags>
<LocalTag Name="FbkTmr" DataType="TIMER" ExternalAccess="None"/>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Start)XIO(Fault)OTE(Out);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Out)XIO(RunFbk)TON(FbkTmr,3000,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(FbkTmr.DN) ,XIC(Overload) ]OTE(Fault);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<Tags>
<Tag Name="EStop_OK" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Emergency stop circuit healthy]]>
</Description>
</Tag>
<Tag Name="Door_Closed" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.1" ExternalAccess="Read/Write">
<Description>
<![CDATA[Guard door closed]]>
</Description>
</Tag>
<Tag Name="Conv1_Fbk" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.2" ExternalAccess="Read/Write">
<Description>
<![CDATA[Conveyor 1 running]]>
</Description>
</Tag>
<Tag Name="Conv1_OL" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.3" ExternalAccess="Read/Write">
<Description>
<![CDATA[Conveyor 1 overload]]>
</Description>
</Tag>
<Tag Name="Part_Present" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.4" ExternalAccess="Read/Write"/>
<Tag Name="Clamp_Extended" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.5" ExternalAccess="Read/Write"/>
<Tag Name="Clamp_Retracted" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.6" ExternalAccess="Read/Write"/>
<Tag Name="Start_PB" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.7" ExternalAccess="Read/Write"/>
<Tag Name="Conv1_Run" TagType="Alias" Radix="Decimal" AliasFor="Local:2:O.Data.0" ExternalAccess="Read/Write">
<Description>
<![CDATA[Conveyor 1 contactor]]>
</Description>
</Tag>
<Tag Name="Clamp_Extend" TagType="Alias" Radix="Decimal" AliasFor="Local:2:O.Data.1" ExternalAccess="Read/Write">
<Description>
<![CDATA[Clamp cylinder extend solenoid]]>
</Description>
</Tag>
<Tag Name="PT101" TagType="Alias" Radix="Decimal" AliasFor="Local:3:I.Ch0Data" ExternalAccess="Read/Write">
<Description>
<![CDATA[Air pressure]]>
</Description>
</Tag>
<Tag Name="Enable" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Step" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[0]]>
</Data>
</Tag>
<Tag Name="Dwell" TagType="Base" DataType="FBD_TIMER" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Conv1" TagType="Base" DataType="Motor_AOI" Constant="false" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Sequence,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sequence" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Station 10 sequence]]>
</Line>
<Line Number="1">
<![CDATA[Enable := EStop_OK AND Door_Closed;]]>
</Line>
<Line Number="2">
<![CDATA[IF NOT Enable THEN Step := 0; Clamp_Extend := 0; Conv1.Start := 0; END_IF;]]>
</Line>
<Line Number="3">
<![CDATA[CASE Step OF]]>
</Line>
<Line Number="4">
<![CDATA[  0: IF Start_PB AND Enable THEN Step := 10; END_IF;]]>
</Line>
<Line Number="5">
<![CDATA[  10: IF Part_Present THEN Step := 20; END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[  20: Clamp_Extend := 1;]]>
</Line>
<Line Number="7">
<![CDATA[      IF Clamp_Extended THEN Step := 30; END_IF;]]>
</Line>
<Line Number="8">
<![CDATA[  30: Conv1.Start := 1;]]>
</Line>
<Line Number="9">
<![CDATA[      IF Conv1_Fbk THEN Step := 40; END_IF;]]>
</Line>
<Line Number="10">
<![CDATA[  40: Dwell.TimerEnable := 1; Dwell.PRE := 4000; TONR(Dwell);]]>
</Line>
<Line Number="11">
<![CDATA[      IF Dwell.DN THEN Step := 50; END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[  50: Conv1.Start := 0; Clamp_Extend := 0;]]>
</Line>
<Line Number="13">
<![CDATA[      IF Clamp_Retracted THEN Step := 0; END_IF;]]>
</Line>
<Line Number="14">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="15">
<![CDATA[Conv1.RunFbk := Conv1_Fbk; Conv1.Overload := Conv1_OL;]]>
</Line>
<Line Number="16">
<![CDATA[Motor_AOI(Conv1);]]>
</Line>
<Line Number="17">
<![CDATA[Conv1_Run := Conv1.Out;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
